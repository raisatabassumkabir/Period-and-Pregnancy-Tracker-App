{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test:*)",
      "Bash(pnpm -r:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm mobile:*)",
      "Bash(pnpm contract:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm check-all:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm expo prebuild:*)",
      "Bash(pnpm e2e-test:*)",
      "Bash(pnpm install-maestro:*)",
      "Bash(pnpm start:*)",
      "Bash(pnpm android:*)",
      "Bash(pnpm ios:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(node .claude/hooks/*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Edit(.env*)",
      "Write(.env*)",
      "Edit(apps/mobile/android/**)",
      "Write(apps/mobile/android/**)",
      "Edit(apps/mobile/ios/**)",
      "Write(apps/mobile/ios/**)",
      "Edit(apps/backend/.env*)",
      "Write(apps/backend/.env*)",
      "Edit(*.key)",
      "Edit(*.pem)",
      "Edit(*.p8)",
      "Edit(*.p12)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(pnpm run app-release:*)",
      "Bash(eas build:*)",
      "Bash(eas submit:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use-secret-guard.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-use-lint.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-smoke-test.js\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-load-context.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
