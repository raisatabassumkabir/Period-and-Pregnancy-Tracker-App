# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (VPS / DOKPLOY)
# =============================================================================

# Domain pointing to your VPS (e.g. api.yourdomain.com)
DOMAIN=api.yourdomain.com

# Django Secret Key (generate a strong 50+ character random string)
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-very-long-random-secret-key-min-50-characters

# Comma-separated list of allowed hostnames and IPs
ALLOWED_HOSTS=api.yourdomain.com,localhost

# Comma-separated list of trusted origins for CSRF protection (must include protocol)
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com

# Comma-separated list of origins allowed to make CORS requests (web dashboard / admin)
CORS_ALLOWED_ORIGINS=https://api.yourdomain.com

# PostgreSQL Database Configuration
POSTGRES_DB=femtech
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate-a-strong-postgres-admin-password

# Non-superuser application database role (REQUIRED for Row Level Security / RLS)
APP_DB_USER=femtech
APP_DB_PASSWORD=generate-a-strong-femtech-app-password

# Application Server Tuning
GUNICORN_WORKERS=3
API_PORT=8000
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=2
