# Production Mobile Client Environment Variables
# Copy this to .env.production (git-ignored) or set these in EAS Dashboard:
# https://expo.dev/accounts/<owner>/projects/<slug>/environment-variables

# Backend base URL - MUST use HTTPS in production! Include trailing slash.
# Replace with the domain you configured in VPS / Dokploy:
API_URL=https://api.yourdomain.com/api/

# Telemetry: Amplitude Analytics & Session Replay (leave blank to disable)
AMPLITUDE_API_KEY=

# Store Listing & Legal Links (Mandatory for Google Play Console submission)
PRIVACY_POLICY_URL=https://yourdomain.com/privacy
TERMS_URL=https://yourdomain.com/terms
SUPPORT_EMAIL=support@yourdomain.com
