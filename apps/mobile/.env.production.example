# Production Mobile Client Environment Variables
# Copy this to .env.production (git-ignored) or set these in EAS Dashboard:
# https://expo.dev/accounts/<owner>/projects/<slug>/environment-variables

# Backend base URL - MUST use HTTPS in production! Include trailing slash.
# Replace with the domain you configured in VPS / Dokploy:
API_URL=https://api.yourdomain.com/api/v1/

# Telemetry: Amplitude events only (leave blank to disable). v1 ships with it off.
AMPLITUDE_API_KEY=

# Store Listing & Legal Links (Mandatory for Google Play Console submission).
# Served by the API (apps/api, /legal/...), so they share its domain and TLS.
PRIVACY_POLICY_URL=https://api.yourdomain.com/legal/privacy/
TERMS_URL=https://api.yourdomain.com/legal/terms/
SUPPORT_EMAIL=support@yourdomain.com

# v1 ships free (FEATURES.monetization = false); leave empty.
REVENUECAT_ANDROID_API_KEY=

# Crash reporting. The DSN is public by design; leave blank to disable.
SENTRY_DSN=
# Source-map upload target (build time). Upload runs only when the
# SENTRY_AUTH_TOKEN EAS secret is set; never put that token in this file.
SENTRY_ORG=
SENTRY_PROJECT=
