# Copy to .env.development / .env.staging / .env.production (all git-ignored).
# env.js loads `.env.${APP_ENV}` and validates it with zod; see env.js for the schema.
#
# EAS builds run with EXPO_NO_DOTENV=1 and no .env file in the repo, so every
# variable below must also exist as an EAS environment variable for the matching
# environment (https://expo.dev/accounts/<owner>/projects/<slug>/environment-variables).

# Backend base URL, including the trailing `/api/`.
#   development: http://10.0.2.2:8000/api/   (Android emulator -> host machine)
#   production:  https://<your-backend-domain>/api/   (HTTPS only; cleartext is blocked in production builds)
API_URL=http://10.0.2.2:8000/api/

# Amplitude Analytics & Session Replay. Leave empty to disable telemetry.
AMPLITUDE_API_KEY=

# Legal + support links shown in Settings and required by the Play listing.
PRIVACY_POLICY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms
SUPPORT_EMAIL=support@example.com
