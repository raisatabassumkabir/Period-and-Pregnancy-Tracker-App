DEBUG=1
SECRET_KEY=change-me-locally
# The app role is deliberately NOT a superuser — Postgres superusers bypass RLS
# entirely (even with FORCE), which would silently disable our second security layer.
DATABASE_URL=postgres://femtech:femtech@localhost:5432/femtech
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Ops toggles (see config/settings/base.py)
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=15
# Proxies in front of the API that append to X-Forwarded-For (Traefik = 1).
DRF_NUM_PROXIES=1
ADMIN_URL=admin/
API_DOCS_ENABLED=false
# Prod only; leave empty locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=femtech-dev

# RevenueCat Server Configuration
REVENUECAT_SECRET_API_KEY=rc_sec_live_placeholder
REVENUECAT_WEBHOOK_AUTHORIZATION=rc_webhook_bearer_placeholder
REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v1
REVENUECAT_REQUEST_TIMEOUT_SECONDS=5
